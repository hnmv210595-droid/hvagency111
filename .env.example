# Copy to .dev.vars for local development (wrangler)
# Never commit real secrets.

# Comma-separated company IPs (Employee login restriction)
COMPANY_IP=115.76.54.149

# Session signing / hashing secret (min 32 chars). Generate with:
#   openssl rand -hex 32
SESSION_SECRET=change-me-to-a-long-random-secret-at-least-32-chars

# Optional overrides
SESSION_TTL_HOURS=24
LOGIN_RATE_LIMIT=10
LOGIN_RATE_WINDOW_MINUTES=15
TIMEZONE=Asia/Ho_Chi_Minh
CURRENCY=VNĐ

# Production secrets via Cloudflare dashboard or wrangler:
#   npx wrangler secret put SESSION_SECRET
#   npx wrangler secret put ADMIN_PASSWORD
# Optional username override (default: Admin111):
#   npx wrangler secret put ADMIN_USERNAME
#
# Local only (.dev.vars — never commit real values):
# ADMIN_USERNAME=Admin111
# ADMIN_PASSWORD=your-local-dev-password-min-8-chars

# Telegram — 2 bots, 1 fixed group (never commit real tokens)
# TELEGRAM_SEND_BOT_TOKEN=123456:AA...   # bot gửi bảng lương ngày 1
# TELEGRAM_RECEIVE_BOT_TOKEN=789012:BB... # bot trả lời chat_id (webhook)
# TELEGRAM_CHAT_ID=-100xxxxxxxxxx        # optional fallback; ưu tiên panel Telegram trên web
# TELEGRAM_WEBHOOK_SECRET=long-random-string
