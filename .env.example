# Copy to .dev.vars for local development (wrangler)
# Never commit real secrets.

# Comma-separated company IPs (Employee login restriction)
COMPANY_IP=115.76.54.149

# Session signing / hashing secret (min 32 chars). Generate with:
#   openssl rand -hex 32
SESSION_SECRET=change-me-to-a-long-random-secret-at-least-32-chars

# Optional overrides
SESSION_TTL_HOURS=24
LOGIN_RATE_LIMIT=10
LOGIN_RATE_WINDOW_MINUTES=15
TIMEZONE=Asia/Ho_Chi_Minh
CURRENCY=VNĐ

# Production: set secrets via Cloudflare dashboard or:
#   npx wrangler secret put SESSION_SECRET
#
# First admin username (used with npm run create-admin — password via ADMIN_PASSWORD env, never commit):
#   ADMIN_USERNAME=Admin111
